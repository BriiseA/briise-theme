{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumière",
	"description": "Douce et élégante : photographes, esthétique, événementiel.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "fond",
					"name": "Fond",
					"color": "#faf6f2"
				},
				{
					"slug": "clair",
					"name": "Fond clair (cartes)",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#eee3da"
				},
				{
					"slug": "nuance",
					"name": "Nuance",
					"color": "#e7ebe3"
				},
				{
					"slug": "texte",
					"name": "Texte",
					"color": "#2b2523"
				},
				{
					"slug": "texte-doux",
					"name": "Texte secondaire",
					"color": "#66595a"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#8a5444"
				},
				{
					"slug": "secondaire",
					"name": "Secondaire",
					"color": "#56614f"
				},
				{
					"slug": "deco",
					"name": "Décor (formes, jamais du texte)",
					"color": "#d8b4a2"
				},
				{
					"slug": "sombre",
					"name": "Fond sombre",
					"color": "#2b2523"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "titres",
					"name": "Titres : Cormorant Garamond",
					"fontFamily": "'Cormorant Garamond', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cormorant-garamond-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "texte",
					"name": "Texte : DM Sans",
					"fontFamily": "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "italic",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans-latin-wght-italic.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"rayon": {
				"grand": "28px",
				"moyen": "24px",
				"petit": "12px",
				"bouton": "999px",
				"photo": "160px 160px 28px 28px"
			},
			"forme": {
				"blob": "50% 50% 0 0 / 40% 40% 0 0"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "500",
					"lineHeight": "1.05",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontStyle": "normal"
				}
			}
		}
	}
}
