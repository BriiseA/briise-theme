{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Comptoir",
	"description": "Vive et conviviale : restaurants, commerces, loisirs.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "fond",
					"name": "Fond",
					"color": "#fff8ee"
				},
				{
					"slug": "clair",
					"name": "Fond clair (cartes)",
					"color": "#ffffff"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#ffe2bf"
				},
				{
					"slug": "nuance",
					"name": "Nuance",
					"color": "#dcf0e5"
				},
				{
					"slug": "texte",
					"name": "Texte",
					"color": "#2a1c13"
				},
				{
					"slug": "texte-doux",
					"name": "Texte secondaire",
					"color": "#5c4738"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#b5311a"
				},
				{
					"slug": "secondaire",
					"name": "Secondaire",
					"color": "#1c6649"
				},
				{
					"slug": "deco",
					"name": "Décor (formes, jamais du texte)",
					"color": "#ffad29"
				},
				{
					"slug": "sombre",
					"name": "Fond sombre",
					"color": "#2a1c13"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "titres",
					"name": "Titres : Fredoka",
					"fontFamily": "'Fredoka', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Fredoka",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fredoka-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "texte",
					"name": "Texte : Nunito",
					"fontFamily": "'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Nunito",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Nunito",
							"fontStyle": "italic",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-latin-wght-italic.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"rayon": {
				"grand": "28px",
				"moyen": "20px",
				"petit": "10px",
				"bouton": "999px",
				"photo": "32px"
			},
			"forme": {
				"blob": "42% 58% 61% 39% / 47% 41% 59% 53%"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.04",
					"letterSpacing": "-0.015em"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|fond"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|texte",
						"text": "var:preset|color|fond"
					}
				}
			}
		}
	}
}
