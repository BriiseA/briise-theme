{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Acier",
	"description": "Métiers du métal (métallerie, serrurerie, chaudronnerie) : gris acier froids, graphite, rouille en accent, titres condensés.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "fond",
					"color": "#ffffff",
					"name": "Fond"
				},
				{
					"slug": "clair",
					"color": "#ffffff",
					"name": "Fond clair (cartes)"
				},
				{
					"slug": "surface",
					"color": "#f2f3f3",
					"name": "Surface"
				},
				{
					"slug": "nuance",
					"color": "#e1e4e6",
					"name": "Nuance"
				},
				{
					"slug": "texte",
					"color": "#15181b",
					"name": "Texte"
				},
				{
					"slug": "texte-doux",
					"color": "#454b51",
					"name": "Texte secondaire"
				},
				{
					"slug": "accent",
					"color": "#ad3f0d",
					"name": "Accent"
				},
				{
					"slug": "secondaire",
					"color": "#4b5258",
					"name": "Secondaire"
				},
				{
					"slug": "deco",
					"color": "#c75a1f",
					"name": "Décor (formes, jamais du texte)"
				},
				{
					"slug": "sombre",
					"color": "#101214",
					"name": "Fond sombre"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "titres",
					"name": "Titres : Barlow Condensed",
					"fontFamily": "'Barlow Condensed', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-condensed-latin-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-condensed-latin-700-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "texte",
					"name": "Texte : Barlow",
					"fontFamily": "'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Barlow",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-latin-400-italic.woff2"
							]
						},
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/barlow-latin-600-normal.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"rayon": {
				"grand": "6px",
				"moyen": "6px",
				"petit": "4px",
				"bouton": "4px",
				"photo": "6px"
			},
			"forme": {
				"blob": "0"
			},
			"cta": {
				"deco": "none"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "0.98",
					"letterSpacing": "0",
					"textTransform": "uppercase"
				}
			},
			"h3": {
				"typography": {
					"textTransform": "none",
					"letterSpacing": "0"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|fond"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|texte",
						"text": "var:preset|color|fond"
					}
				}
			}
		}
	}
}
